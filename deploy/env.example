# Copy to deploy/.env on the NAS (git ignores .env) and fill in.
# The Ollama address the local profiles use, for example http://<gpu-host>:11434
OLLAMA_URL=
# Total VRAM of the GPU, in GB
VRAM_GB=24
# Only if Hermes keeps its data somewhere else than /DATA/AppData/hermes:
# CODEX_SESSIONS_HOST=/DATA/AppData/hermes/home/.codex/sessions
# BURN_FILE_HOST=/DATA/AppData/hermes/handoff/burn.json
# CLAUDE_HOME_HOST=/DATA/AppData/hermes/home/.claude
# HERMES_DATA_HOST=/DATA/AppData/hermes   (the ship probe reads it read-only)
