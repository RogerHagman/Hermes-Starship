# Copy to deploy/.env (git ignores .env) and fill in. Only the first two are required.

# Required. Where Hermes keeps its data on this host: the folder mounted as /opt/data inside the
# Hermes container. The probes read it read-only.
HERMES_DATA_HOST=
# Required. The Ollama address your local profiles use, for example http://<gpu-host>:11434
OLLAMA_URL=

# Your time zone (IANA name), for the meters' day and week edges. Set the same name as "timezone"
# in fixtures/ship.json, which the boards' clock uses.
# SHIP_TIMEZONE=Europe/Stockholm

# Total VRAM of the GPU, in GB
VRAM_GB=24
# The user and group Hermes runs as (10000 in the Hermes image). The Yeoman's desk runs as them.
# HERMES_UID=10000
# HERMES_GID=10000

# Only if these live somewhere else than inside HERMES_DATA_HOST:
# CODEX_SESSIONS_HOST=<HERMES_DATA_HOST>/home/.codex/sessions
# BURN_FILE_HOST=<HERMES_DATA_HOST>/handoff/burn.json
# CLAUDE_HOME_HOST=<HERMES_DATA_HOST>/home/.claude

# The Ops probe watches two disks by default: the one this repo is on, and the system disk.
# Each entry is path in the probe|DK id|name|mount on the host. To add a third disk, point slot 3
# at any folder on it and list all three:
# DISK_1_HOST=..
# DISK_3_HOST=<a folder on the backup disk>
# OPS_DISKS=/disks/1|DK-901|Data disk|/;/disks/2|DK-903|System disk|/;/disks/3|DK-902|Backup disk|<its mount>

# The speed trial uses the model Ollama has loaded. Only if none is loaded, it loads this one:
# TRIAL_MODEL=

# The holo probe (Review bay): your fork of this repo (owner/name), and a GitHub fine-grained
# sign-in for that repo only, read-only: Contents, Pull requests, Actions and Metadata. Never one
# that can write. Without the sign-in the Review bay keeps its sample.
# STARSHIP_REPO=<owner>/Hermes-Starship
# GITHUB_READ=
# The main watch flags commits on main since WATCH_FROM that came in without a merged PR.
# WATCH_FROM=2026-01-01T00:00:00Z
# Commits you have looked at and cleared, comma-separated.
# MAIN_OK=
