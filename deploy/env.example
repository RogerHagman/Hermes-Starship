# Copy to deploy/.env on the NAS (git ignores .env) and fill in.
# The Ollama address the local profiles use, for example http://<gpu-host>:11434
OLLAMA_URL=
# Total VRAM of the GPU, in GB
VRAM_GB=24
# Only if Hermes keeps its data somewhere else than /DATA/AppData/hermes:
# CODEX_SESSIONS_HOST=/DATA/AppData/hermes/home/.codex/sessions
# BURN_FILE_HOST=/DATA/AppData/hermes/handoff/burn.json
# CLAUDE_HOME_HOST=/DATA/AppData/hermes/home/.claude
# HERMES_DATA_HOST=/DATA/AppData/hermes   (the ship probe reads it read-only)
# The Ops probe watches two disks by default: /DATA and the NAS system disk. To add the backup
# disk, point slot 3 at any folder on it and list all three (path|DK id|name|mount on the NAS):
# DISK_3_HOST=<a folder on the backup disk>
# OPS_DISKS=/disks/1|DK-901|NAS data|/DATA;/disks/2|DK-903|NAS system|/;/disks/3|DK-902|Backup disk|<its mount>
# The speed trial uses the model Ollama has loaded. Only if none is loaded, it loads this one:
# TRIAL_MODEL=
# The holo probe (Review bay): a GitHub fine-grained sign-in for RogerHagman/Hermes-Starship only,
# read-only: Contents, Pull requests, Actions and Metadata. Never one that can write.
# GITHUB_READ=
# The main watch: commits on main without a merged PR you have looked at and cleared, comma-separated.
# MAIN_OK=
