{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asOf",
    "synthetic",
    "orders"
  ],
  "properties": {
    "asOf": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "synthetic": {
      "type": "boolean"
    },
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "station",
          "state",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ORD-\\d{4}$"
          },
          "title": {
            "type": "string"
          },
          "station": {
            "type": "string"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "review",
              "awaiting-captain",
              "blocked",
              "done"
            ]
          },
          "tier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "The risk tier, 0 to 3. Live orders have none until the tier classifier (conn handoff) is built."
          },
          "speed": {
            "enum": [
              "Thrusters",
              "Quarter Impulse",
              "Half Impulse",
              "Full Impulse",
              "Impulse",
              "Warp",
              "Warp 9",
              "High Warp",
              "Maximum Warp"
            ],
            "description": "The Captain's speed word (docs/04-speed-scale.md). Impulse and High Warp are the older sample words."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
          },
          "openedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
            "description": "When the order came in (orders.csv received_at, else its first card)."
          },
          "closedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
            "description": "When the order closed. Done orders only."
          },
          "surface": {
            "type": "string",
            "description": "Where the Captain gave it: telegram, desktop, dashboard, ..."
          },
          "cards": {
            "type": "integer",
            "minimum": 0,
            "description": "How many Kanban cards were filed for it. 0: answered in chat, or never picked up."
          },
          "parent": {
            "type": "string",
            "pattern": "^ORD-\\d{4}$"
          },
          "mission": {
            "type": "string",
            "pattern": "^MSN-\\d{3}$"
          },
          "detail": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "description": "The card body as filed, plain text. A line that starts with GOAL:, CONTEXT:, CONSTRAINTS:, DONE WHEN: or START WITH: begins a section; a line that starts with '- ' is a list item."
          },
          "replies": {
            "type": "array",
            "description": "What came back on the order, oldest first: the answer the Captain was sent, a card's result, a run's summary or error, and comments. The newest few only.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "at",
                "by",
                "kind",
                "text"
              ],
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
                },
                "by": {
                  "type": "string",
                  "description": "A station id, or the name of whoever wrote it."
                },
                "kind": {
                  "enum": [
                    "answer",
                    "result",
                    "run",
                    "error",
                    "comment"
                  ]
                },
                "text": {
                  "type": "string",
                  "description": "Plain text, as written."
                }
              }
            }
          }
        }
      }
    }
  },
  "title": "Hermes Starship · orders"
}
