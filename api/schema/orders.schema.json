{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asOf",
    "synthetic",
    "orders"
  ],
  "properties": {
    "asOf": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "synthetic": {
      "type": "boolean"
    },
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "station",
          "state",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ORD-\\d{4}$"
          },
          "title": {
            "type": "string"
          },
          "station": {
            "type": "string"
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "review",
              "awaiting-captain",
              "blocked",
              "done"
            ]
          },
          "tier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "The risk tier, 0 to 3. Live orders have none until the tier classifier (conn handoff) is built."
          },
          "speed": {
            "enum": [
              "Thrusters",
              "Quarter Impulse",
              "Half Impulse",
              "Full Impulse",
              "Impulse",
              "Warp",
              "Warp 9",
              "High Warp",
              "Maximum Warp"
            ],
            "description": "The Captain's speed word (docs/04-speed-scale.md). Impulse and High Warp are the older sample words."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
          },
          "parent": {
            "type": "string",
            "pattern": "^ORD-\\d{4}$"
          },
          "mission": {
            "type": "string",
            "pattern": "^MSN-\\d{3}$"
          },
          "detail": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "description": "The card body as filed, plain text. A line that starts with GOAL:, CONTEXT:, CONSTRAINTS:, DONE WHEN: or START WITH: begins a section; a line that starts with '- ' is a list item."
          }
        }
      }
    }
  },
  "title": "Hermes Starship · orders"
}
