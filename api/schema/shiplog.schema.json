{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asOf",
    "synthetic",
    "entries"
  ],
  "properties": {
    "asOf": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "synthetic": {
      "type": "boolean"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "station",
          "kind",
          "text"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
          },
          "station": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "order",
              "split",
              "hail",
              "customs",
              "review",
              "done",
              "rail"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  },
  "title": "Hermes Starship \u00b7 shiplog"
}
