{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asOf",
    "synthetic",
    "campaigns",
    "missions",
    "log",
    "standingOrders",
    "yeoman",
    "reading"
  ],
  "properties": {
    "asOf": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "synthetic": {
      "type": "boolean"
    },
    "campaigns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "objective",
          "measure",
          "percent",
          "target",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CMP-\\d{3}$"
          },
          "name": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "measure": {
            "type": "string"
          },
          "percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "target": {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d$",
            "description": "Target month, YYYY-MM."
          },
          "status": {
            "enum": [
              "active",
              "paused",
              "done"
            ]
          }
        }
      }
    },
    "missions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "doneWhen",
          "stations",
          "progress",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MSN-\\d{3}$"
          },
          "name": {
            "type": "string"
          },
          "campaign": {
            "type": "string",
            "pattern": "^CMP-\\d{3}$"
          },
          "doneWhen": {
            "type": "string"
          },
          "stations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "progress": {
            "type": "string"
          },
          "status": {
            "enum": [
              "awaiting-captain",
              "in-flight",
              "planning",
              "closed"
            ]
          }
        }
      }
    },
    "log": {
      "type": "array",
      "description": "The captain's log. Stays on the local rail; only the Ship's Computer reads it.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "text"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "standingOrders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "yeoman": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "kind",
          "due"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Y-\\d{3}$"
          },
          "text": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "todo",
              "reminder",
              "waiting"
            ]
          },
          "due": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
          }
        }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "read",
        "goal",
        "current",
        "next"
      ],
      "properties": {
        "year": {
          "type": "integer"
        },
        "read": {
          "type": "integer",
          "minimum": 0
        },
        "goal": {
          "type": "integer",
          "minimum": 1
        },
        "current": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "author",
              "percent"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "percent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "next": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "author"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "author": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "title": "Hermes Starship · quarters"
}
